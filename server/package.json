    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2"
  }
