{
  "name": "metromind-ai-server",
  "version": "1.0.0",
  "description": "MetroMind AI REST API - Intelligent Metro Route Optimization and Network Analytics",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
